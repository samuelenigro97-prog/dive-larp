{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dive-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE_DO",
        "class_name": "DiveStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DiveStateDO"]
    }
  ]
}
